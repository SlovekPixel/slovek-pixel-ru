# Node
TZ=UTC
PORT=3333
HOST=127.0.0.1
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=memory

# Public hostname (same name for site and TeamSpeak voice)
DOMAIN=ts.slovekpixel.ru

# TeamSpeak 3 ServerQuery (use 127.0.0.1 when TS runs via docker compose on the host)
TS3_QUERY_HOST=127.0.0.1
TS3_QUERY_PORT=10011
TS3_QUERY_USER=serveradmin
TS3_QUERY_PASSWORD=change-me-serveradmin
