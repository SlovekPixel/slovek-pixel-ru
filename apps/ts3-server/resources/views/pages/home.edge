@layout()
  <div class="hero">
    <h1>Homepage</h1>

    <div
      class="service-status {{ teamspeak.isActive ? 'is-active' : 'is-inactive' }}"
      data-status-root
    >
      <p class="service-line">
        Linux TeamSpeak service:
        @if(teamspeak.isActive)
          <strong data-field="activeLabel">is active</strong>
          <span class="service-version {{ teamspeak.version ? '' : 'is-empty' }}" data-field="version">
            @if(teamspeak.version)
              ({{ teamspeak.version }})
            @end
          </span>
        @else
          <strong data-field="activeLabel">inactive</strong>
          <span class="service-version is-empty" data-field="version"></span>
        @end
      </p>
      <p class="voice-host">
        Voice server: <code data-field="voiceHost">{{ teamspeak.voiceHost }}</code> (UDP 9987)
      </p>

      <dl class="status-metrics">
        <div>
          <dt>Name</dt>
          <dd data-field="serverName">{{ teamspeak.serverName }}</dd>
        </div>
        <div>
          <dt>Uptime</dt>
          <dd data-field="uptimeLabel">{{ teamspeak.uptimeLabel }}</dd>
        </div>
        <div>
          <dt>License</dt>
          <dd data-field="licenseLabel">{{ teamspeak.licenseLabel }}</dd>
        </div>
        <div>
          <dt>Clients</dt>
          <dd data-field="clientsLabel">{{ teamspeak.clientsLabel }}</dd>
        </div>
        <div>
          <dt>Channels</dt>
          <dd data-field="channelsLabel">{{ teamspeak.channelsLabel }}</dd>
        </div>
        <div>
          <dt>Average ping</dt>
          <dd data-field="pingLabel">{{ teamspeak.pingLabel }}</dd>
        </div>
        <div>
          <dt>Packet loss</dt>
          <dd data-field="packetLossLabel">{{ teamspeak.packetLossLabel }}</dd>
        </div>
      </dl>

      <div class="status-online">
        <h2>Online</h2>
        <ul class="online-list" data-field="onlineClients">
          @if(teamspeak.onlineClients === null)
            <li class="online-empty">—</li>
          @elseif(teamspeak.onlineClients.length === 0)
            <li class="online-empty">No one connected</li>
          @else
            @each(client in teamspeak.onlineClients)
              <li>
                <span class="online-nick">{{ client.nickname }}</span>
                <span class="online-channel">{{ client.channelName }}</span>
              </li>
            @end
          @end
        </ul>
      </div>
    </div>
  </div>
@end
