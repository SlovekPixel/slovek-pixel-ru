# Copy to .env and fill in before: docker compose up --build
#   cp .env.example .env

# --- Domain (site HTTPS + TeamSpeak voice on the same hostname) ---
DOMAIN=ts.slovekpixel.ru
APP_URL=https://ts.slovekpixel.ru
CERTBOT_EMAIL=you@example.com

# --- Web (Adonis) ---
APP_KEY=change-me-generate-with-node-ace-generate-key
PORT=3333
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
SESSION_DRIVER=cookie

# ServerQuery from the web container (Docker network hostname)
TS3_QUERY_HOST=teamspeak
TS3_QUERY_PORT=10011
TS3_QUERY_USER=serveradmin
# Must match TS3_SERVERADMIN_PASSWORD
TS3_QUERY_PASSWORD=change-me-serveradmin

# --- TeamSpeak 3 (free: 1 virtual server, 32 slots) ---
TS3SERVER_LICENSE=accept
TS3_SERVERADMIN_PASSWORD=change-me-serveradmin
TS3SERVER_QUERY_PROTOCOLS=raw

# Optional TS3 vars (uncomment if needed):
# TS3SERVER_LICENSEPATH=/var/ts3server
# TS3SERVER_QUERY_TIMEOUT=300
# TS3SERVER_LOG_QUERY_COMMANDS=0
# TS3SERVER_LOG_APPEND=0
# TS3SERVER_DB_CLIENTKEEPDAYS=30
# TS3SERVER_IP_WHITELIST=query_ip_whitelist.txt
# TS3SERVER_IP_BLACKLIST=query_ip_blacklist.txt
# For MariaDB instead of built-in SQLite, set TS3SERVER_DB_* (see Docker Hub teamspeak docs)
